{
  "name": "stellan-oli-oli-desktop",
  "version": "1.2.1",
  "private": true,
  "description": "Windows desktop app for the Stellan Oli Oli fan site",
  "repository": {
    "type": "git",
    "url": "https://github.com/stellanfreya/stellan-oli-oli.git"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "build:desktop": "esbuild desktop/home.js --bundle --platform=browser --target=chrome120 --format=iife --outfile=desktop/renderer.bundle.js",
    "start": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.stellanfreya.stellanolioli",
    "productName": "Stellan Oli Oli",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "config.js",
      "assets/**/*.mp4",
      "images/**/*",
      "app-icon.svg",
      "app-icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Stellan-Oli-Oli-Setup.exe"
    },
    "asarUnpack": [
      "assets/**/*.mp4",
      "images/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stellan Oli Oli",
      "installerIcon": "app-icon.ico",
      "uninstallerIcon": "app-icon.ico"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2"
  }
}
